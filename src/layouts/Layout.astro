---
import '../styles/index.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = "Global Self-Healthcare Education and Research (GSHER)",
  description = "Empowering individuals through Self-Healthcare education, Cellular Revival (CelluReva), and proactive wellness. Shift from doctor-dependent reactive treatment to daily self-care.",
  keywords = "Global Self Healthcare, Self Healthcare Education, Cellular Health, CelluReva, Dr Biswajit Mohapatra, No Prescription Point"
} = Astro.props;

const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/\/$/, "");
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=32,fit=crop/dWxnO74qGGcN789B/queen-logo-design-1-YD0ro0oK5jUnP1oQ.png" />

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>

  <!-- ==========================================
       Section 1: Navbar
       ========================================== -->
  <header class="navbar" id="navbar">
    <div class="container">
      <a href="/#home" class="logo">
        <img
          src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=90,fit=crop/dWxnO74qGGcN789B/queen-logo-design-1-YD0ro0oK5jUnP1oQ.png"
          alt="GSHER Logo" class="logo-img" />
        <div class="logo-text">
          <span class="logo-title">GSHER India</span>
          <span class="logo-sub">Global Self-Healthcare</span>
        </div>
      </a>

      <nav>
        <ul class="nav-links" id="nav-links">
          <li class="nav-item"><a href="/#home" class={currentPath === '' || currentPath === '/' ? 'active' : ''}>Home</a></li>
          <li class="nav-item"><a href="/about" class={currentPath === '/about' ? 'active' : ''}>About Us</a></li>
          <li class="nav-item"><a href="/#crisis">Why Self-Healthcare</a></li>
          <li class="nav-item"><a href="/#books">Books</a></li>
          <li class="nav-item"><a href="/#videos">Videos</a></li>
          <li class="nav-item"><a href="/#npp">NPP</a></li>
          <li class="nav-item"><a href="/#imwrc">IMWRC</a></li>
          <li class="nav-item"><a href="/#blog">Blog</a></li>
          <li class="nav-item"><a href="/#contact" class="btn-outline"
              style="padding: 6px 16px; font-size: 14px; margin-left: 10px;">Contact</a></li>
        </ul>
      </nav>

      <button class="mobile-nav-toggle" id="mobile-toggle" aria-label="Toggle Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <slot />

  <!-- ==========================================
       Section 16: Footer & Contact Section
       ========================================== -->
  <footer class="footer" id="contact">
    <div class="container">
      <div class="footer-grid">
        <!-- Col 1: Brand details -->
        <div class="footer-col">
          <div class="footer-logo">
            <img
              src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=90,fit=crop/dWxnO74qGGcN789B/queen-logo-design-1-YD0ro0oK5jUnP1oQ.png"
              alt="GSHER Logo" class="footer-logo-img" />
            <div class="footer-logo-text">
              <span class="footer-logo-title">GSHER India</span>
              <span class="footer-logo-sub">Global Self-Healthcare</span>
            </div>
          </div>
          <p class="footer-about-text">
            Global Self-Healthcare Education and Research (GSHER) is a non-profit organization dedicated to empowering
            individuals with the biological intelligence and tools needed to protect and preserve their health.
          </p>
        </div>

        <!-- Col 2: Navigation Links -->
        <div class="footer-col">
          <h4>Quick Links</h4>
          <ul class="footer-links">
            <li><a href="/#home">Home</a></li>
            <li><a href="/about">About Us</a></li>
            <li><a href="/#crisis">Why Self-Healthcare</a></li>
            <li><a href="/#books">Books</a></li>
            <li><a href="/#videos">Videos</a></li>
            <li><a href="/#npp">NPP Center</a></li>
            <li><a href="/#imwrc">Research Centre</a></li>
            <li><a href="/#blog">Blog Posts</a></li>
          </ul>
        </div>

        <!-- Col 3: Contact Info -->
        <div class="footer-col">
          <h4>Contact Us</h4>
          <div class="footer-contact-item">
            <span class="footer-contact-icon"><i class="fa-solid fa-location-dot"></i></span>
            <span>Chhend Colony, Rourkela, Odisha, India - 769015</span>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-icon"><i class="fa-solid fa-phone"></i></span>
            <span>+91 9437042490</span>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-icon"><i class="fa-solid fa-envelope"></i></span>
            <span>info@globalselfhealthcare.org</span>
          </div>
        </div>

        <!-- Col 4: Connect & Socials -->
        <div class="footer-col">
          <h4>Connect With Us</h4>
          <p>Follow our educational channels and stay updated on workshops.</p>
          <div class="footer-socials">
            <a href="https://www.facebook.com/globalselfcare/" target="_blank" rel="noopener noreferrer"
              class="footer-social-icon" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="https://www.youtube.com/@GlobalSelfHealthcareEducation" target="_blank" rel="noopener noreferrer"
              class="footer-social-icon" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
            <a href="https://wa.me/919437042490" target="_blank" rel="noopener noreferrer" class="footer-social-icon"
              aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
            <a href="mailto:info@globalselfhealthcare.org" class="footer-social-icon" aria-label="Email"><i
                class="fa-solid fa-envelope"></i></a>
          </div>
        </div>
      </div>

      <!-- Footer Bottom -->
      <div class="footer-bottom">
        <p>Copyright &copy; 2026 GSHER Trust India. All rights reserved.</p>
        <div class="footer-bottom-links">
          <a href="https://www.globalselfhealthcare.org/privacy-policy-global-self-healthcare" target="_blank">Privacy
            Policy</a>
          <a href="https://www.globalselfhealthcare.org/terms-and-conditions-self-healthcare" target="_blank">Terms &
            Conditions</a>
          <a href="https://www.globalselfhealthcare.org/refund-policy-zznqgqself-healthcare-movement"
            target="_blank">Refund Policy</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- JavaScript script inclusion -->
  <script>
    import '../scripts/index.js';
  </script>
</body>
</html>
