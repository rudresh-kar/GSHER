---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../site.config.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessage)}`;
---

<Layout>

  <!-- ==========================================
       HERO SECTION
       ========================================== -->
  <section class="hero" id="home">
    <!-- Background glows -->
    <div class="hero-bg-glow hero-bg-glow-1"></div>
    <div class="hero-bg-glow hero-bg-glow-2"></div>

    <div class="container">
      <div class="hero-grid">
        <!-- Left: Content -->
        <div class="hero-content">
          <div class="hero-tag">
            <i class="fa-solid fa-dna"></i>
            Cellular Health Protocol
          </div>
          <h1 class="hero-headline">
            Revive Your Health<br/>at the <span class="gold">Cellular Level</span>
          </h1>
          <p class="hero-subheadline">
            {siteConfig.siteName} is a science-backed protocol by {siteConfig.founder.name} that integrates yoga, nutrition, sleep, and mindfulness to heal and protect your body — from the inside out.
          </p>
          <div class="hero-cta-group">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
              <i class="fa-brands fa-whatsapp"></i> Book Consultation
            </a>
            <a href="#protocol" class="btn-outline-light">
              Explore the Protocol <i class="fa-solid fa-arrow-down"></i>
            </a>
          </div>
        </div>

        <!-- Right: Animated Cell SVG -->
        <div class="hero-visual">
          <div class="hero-svg-container">
            <svg viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg" class="biological-cell-svg">
              <defs>
                <!-- Glow Filters -->
                <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="8" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
                <filter id="soft-glow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="4" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
                
                <!-- Living Membrane Morphing Filter -->
                <filter id="membrane-morph" x="-10%" y="-10%" width="120%" height="120%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="3" result="noise">
                    <animate attributeName="baseFrequency" values="0.015;0.02;0.015" dur="15s" repeatCount="indefinite" />
                  </feTurbulence>
                  <feDisplacementMap in="SourceGraphic" in2="noise" scale="18" xChannelSelector="R" yChannelSelector="G" />
                </filter>

                <!-- Internal Organelle Morphing Filter -->
                <filter id="organelle-morph" x="-20%" y="-20%" width="140%" height="140%">
                  <feTurbulence type="turbulence" baseFrequency="0.02" numOctaves="2" result="noise">
                    <animate attributeName="baseFrequency" values="0.02;0.025;0.02" dur="8s" repeatCount="indefinite" />
                  </feTurbulence>
                  <feDisplacementMap in="SourceGraphic" in2="noise" scale="8" xChannelSelector="R" yChannelSelector="G" />
                </filter>

                <!-- Gradients -->
                <!-- Cytoplasm (Cell Body Fluid) -->
                <radialGradient id="cytoplasmGrad" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#14533a" stop-opacity="0.35" />
                  <stop offset="70%" stop-color="#0c2a1b" stop-opacity="0.2" />
                  <stop offset="100%" stop-color="#0c2a1b" stop-opacity="0.0" />
                </radialGradient>

                <!-- Nucleus Gradient -->
                <radialGradient id="nucleusGrad" cx="35%" cy="35%" r="65%">
                  <stop offset="0%" stop-color="#f5e6c8" />
                  <stop offset="40%" stop-color="#c9a96e" />
                  <stop offset="85%" stop-color="#14533a" />
                  <stop offset="100%" stop-color="#0c2a1b" />
                </radialGradient>

                <!-- Nucleolus Gradient (Very center) -->
                <radialGradient id="nucleolusGrad" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#ffffff" />
                  <stop offset="60%" stop-color="#f5e6c8" />
                  <stop offset="100%" stop-color="#c9a96e" />
                </radialGradient>

                <!-- Organelle Gold Gradient -->
                <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#f5e6c8" />
                  <stop offset="100%" stop-color="#c9a96e" />
                </linearGradient>

                <!-- Organelle Green Gradient -->
                <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#1d7a4e" />
                  <stop offset="100%" stop-color="#14533a" />
                </linearGradient>
              </defs>

              <!-- Outer Molecular Orbit Rings (Floating Energy Field) -->
              <g class="orbit-group" style="animation: rotate 35s linear infinite;">
                <circle class="orbit-ring" cx="250" cy="250" r="242" stroke-dasharray="8 12" />
                <circle class="orbit-dot glow-dot" cx="492" cy="250" r="5" fill="#c9a96e" filter="url(#soft-glow)" />
              </g>
              <g class="orbit-group" style="animation: rotate 45s linear infinite reverse;">
                <circle class="orbit-ring" cx="250" cy="250" r="222" stroke-dasharray="3 6" />
                <circle class="orbit-dot glow-dot" cx="250" cy="28" r="4" fill="#1d7a4e" filter="url(#soft-glow)" />
                <circle class="orbit-dot glow-dot" cx="250" cy="472" r="3" fill="#c9a96e" filter="url(#soft-glow)" />
              </g>

              <!-- Cell Body Scaling Group (1.45x size increase to fill space) -->
              <g transform="scale(1.45)" transform-origin="250 250">
                <!-- Cytoskeleton / Microfilaments (Structural Fine Netting) -->
                <g opacity="0.12" stroke="#c9a96e" stroke-width="0.5" fill="none">
                  <path d="M 250,250 L 120,180 M 250,250 L 380,180 M 250,250 L 150,330 M 250,250 L 350,330 M 250,250 L 250,90 M 250,250 L 250,410" />
                  <!-- Web arcs -->
                  <path d="M 170,208 A 95 95 0 0 1 330,208 A 95 95 0 0 1 310,302 A 95 95 0 0 1 190,302 Z" />
                  <path d="M 130,190 A 145 145 0 0 1 370,190 A 145 145 0 0 1 340,318 A 145 145 0 0 1 160,318 Z" />
                </g>

                <!-- Microtubule Transport Paths (Adds scientific details to cytoplasm) -->
                <g stroke="#1d7a4e" stroke-width="0.8" opacity="0.25" fill="none">
                  <path d="M 230,220 Q 200,170 170,180" />
                  <path d="M 270,220 Q 305,180 330,200" />
                  <path d="M 220,270 Q 185,300 175,325" stroke="#c9a96e" stroke-width="0.6" />
                  <path d="M 280,270 Q 310,310 330,290" />
                </g>

                <!-- Cell Cytoplasm (Fluid Body) with Morphing -->
                <circle cx="250" cy="250" r="140" fill="url(#cytoplasmGrad)" filter="url(#membrane-morph)" />

                <!-- Outer Membrane (Lipid Bilayer - Double Ring) -->
                <circle class="cell-membrane-outer" cx="250" cy="250" r="142" fill="none" stroke="#c9a96e" stroke-width="1.5" opacity="0.35" filter="url(#membrane-morph)" />
                <circle class="cell-membrane-inner" cx="250" cy="250" r="137" fill="none" stroke="#1d7a4e" stroke-width="2.5" opacity="0.6" filter="url(#membrane-morph)" />
                <circle class="cell-membrane-glowing" cx="250" cy="250" r="139" fill="none" stroke="#c9a96e" stroke-width="1" opacity="0.8" filter="url(#membrane-morph) url(#soft-glow)" />

                <!-- Floating Organelles inside Cytoplasm -->
                
                <!-- 1. Mitochondria (Gold/Green, pulsing) - Quadrant 1 (Top Left) -->
                <g transform="translate(140, 160) rotate(25)">
                  <g style="animation: float 6s ease-in-out infinite;">
                    <rect x="-22" y="-12" width="44" height="24" rx="12" fill="url(#greenGrad)" stroke="#c9a96e" stroke-width="1.2" filter="url(#organelle-morph)" />
                    <!-- Inner folds (Cristae) -->
                    <path d="M -15,-6 L -10,6 L -5,-6 L 0,6 L 5,-6 L 10,6 L 15,-6" fill="none" stroke="#c9a96e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </g>
                </g>

                <!-- Mitochondria - Quadrant 2 (Bottom Right) -->
                <g transform="translate(340, 310) rotate(-40)">
                  <g style="animation: float 7s ease-in-out infinite -2s;">
                    <rect x="-24" y="-14" width="48" height="28" rx="14" fill="url(#greenGrad)" stroke="#c9a96e" stroke-width="1.2" filter="url(#organelle-morph)" />
                    <path d="M -17,-8 L -11,8 L -5,-8 L 1,8 L 7,-8 L 13,8 L 17,-8" fill="none" stroke="#c9a96e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </g>
                </g>

                <!-- Mitochondria - Quadrant 3 (Top Right) -->
                <g transform="translate(320, 240) rotate(60)">
                  <g style="animation: float 5.5s ease-in-out infinite -1s;">
                    <rect x="-20" y="-10" width="40" height="20" rx="10" fill="url(#greenGrad)" stroke="#c9a96e" stroke-width="1.2" filter="url(#organelle-morph)" />
                    <path d="M -13,-5 L -9,5 L -5,-5 L -1,5 L 3,-5 L 7,5 L 11,-5" fill="none" stroke="#c9a96e" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                  </g>
                </g>

                <!-- Mitochondria - Quadrant 4 (Bottom Left) -->
                <g transform="translate(170, 195) rotate(-65)">
                  <g style="animation: float 6.5s ease-in-out infinite -3s;">
                    <rect x="-22" y="-12" width="44" height="24" rx="12" fill="url(#greenGrad)" stroke="#c9a96e" stroke-width="1.2" filter="url(#organelle-morph)" />
                    <path d="M -15,-6 L -10,6 L -5,-6 L 0,6 L 5,-6 L 10,6 L 15,-6" fill="none" stroke="#c9a96e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </g>
                </g>

                <!-- 2. Golgi Apparatus (Gold curved stacks) -->
                <g transform="translate(330, 170) rotate(-15)">
                  <g style="animation: float 8s ease-in-out infinite -4s;">
                    <path d="M -20,-15 Q -5,-12 10,-15 M -22,-7 Q -7,-4 8,-7 M -20,1 Q -5,4 10,1 M -16,9 Q -3,11 10,9" fill="none" stroke="#c9a96e" stroke-width="2.2" stroke-linecap="round" opacity="0.8" filter="url(#soft-glow)" />
                    <circle cx="16" cy="-14" r="2.5" fill="#c9a96e" opacity="0.7" />
                    <circle cx="-25" cy="-6" r="2" fill="#1d7a4e" opacity="0.8" />
                    <circle cx="18" cy="8" r="3" fill="#c9a96e" opacity="0.9" />
                  </g>
                </g>

                <!-- Vesicle Clusters (Golgi outputs) -->
                <g fill="#c9a96e" opacity="0.8">
                  <circle cx="320" cy="140" r="2.5" />
                  <circle cx="310" cy="145" r="2" />
                  <circle cx="280" cy="330" r="3" fill="#1d7a4e" />
                  <circle cx="288" cy="334" r="2" />
                </g>

                <!-- Centrioles (Paired barrels near nucleus) -->
                <g transform="translate(292, 218) rotate(20)">
                  <rect x="-3" y="-8" width="6" height="16" fill="url(#goldGrad)" rx="1.5" stroke="#c9a96e" stroke-width="0.5" />
                  <rect x="-8" y="-3" width="16" height="6" fill="url(#goldGrad)" rx="1.5" stroke="#c9a96e" stroke-width="0.5" transform="translate(4, 4) rotate(90)" />
                </g>

                <!-- 3. Lysosome / Centrosome (Green/Gold spheres) -->
                <g transform="translate(160, 320)">
                  <g style="animation: float 5s ease-in-out infinite -1s;">
                    <circle cx="0" cy="0" r="10" fill="url(#greenGrad)" stroke="#c9a96e" stroke-width="1" />
                    <circle cx="0" cy="0" r="5" fill="#f5e6c8" opacity="0.6" filter="url(#soft-glow)" />
                  </g>
                </g>
                <g transform="translate(190, 340)">
                  <g style="animation: float 6s ease-in-out infinite -3s;">
                    <circle cx="0" cy="0" r="6" fill="url(#goldGrad)" />
                  </g>
                </g>

                <!-- 4. Endoplasmic Reticulum (Reticular network around nucleus) -->
                <g opacity="0.35" fill="none" stroke="#1d7a4e" stroke-width="1.5" filter="url(#organelle-morph)">
                  <path d="M 210,210 Q 180,220 185,250 T 205,290 M 290,210 Q 320,220 315,250 T 295,290 M 215,200 Q 250,175 285,200" />
                  <path d="M 195,230 Q 170,240 175,260 T 195,280 M 305,230 Q 330,240 325,260 T 305,280" stroke="#c9a96e" stroke-width="1" />
                </g>

                <!-- Cell Nucleus (Living glowing core) -->
                <circle class="cell-nucleus-body" cx="250" cy="250" r="52" fill="url(#nucleusGrad)" stroke="#c9a96e" stroke-width="1" filter="url(#organelle-morph) url(#soft-glow)" />
                
                <!-- Nucleolus (Central generator) -->
                <circle cx="240" cy="242" r="16" fill="url(#nucleolusGrad)" filter="url(#soft-glow)">
                  <animate attributeName="r" values="15;17;15" dur="4s" repeatCount="indefinite" />
                </circle>

                <!-- Chromatin (DNA threads in nucleus) -->
                <path d="M 235,220 Q 242,228 230,240 T 255,255 T 235,275 M 265,225 Q 250,235 260,250 T 245,270" fill="none" stroke="#f5e6c8" stroke-width="1" opacity="0.4" />

                <!-- DNA Double Helix wrapping through the cell -->
                <g class="dna-helix-group" style="opacity: 0.85;">
                  <!-- Helix 1 -->
                  <path class="dna-strand-1" d="M 170,170 Q 200,150 250,170 T 330,170" fill="none" stroke="url(#goldGrad)" stroke-width="2" filter="url(#soft-glow)">
                    <animate attributeName="d" values="M 170,170 Q 200,150 250,170 T 330,170; M 170,170 Q 200,190 250,170 T 330,170; M 170,170 Q 200,150 250,170 T 330,170" dur="6s" repeatCount="indefinite" />
                  </path>
                  <!-- Helix 2 -->
                  <path class="dna-strand-2" d="M 170,170 Q 200,190 250,170 T 330,170" fill="none" stroke="#1d7a4e" stroke-width="1.5">
                    <animate attributeName="d" values="M 170,170 Q 200,190 250,170 T 330,170; M 170,170 Q 200,150 250,170 T 330,170; M 170,170 Q 200,190 250,170 T 330,170" dur="6s" repeatCount="indefinite" />
                  </path>
                  <!-- Connectors -->
                  <g stroke="#c9a96e" stroke-width="1" opacity="0.6">
                    <line x1="190" y1="165" x2="190" y2="175" />
                    <line x1="210" y1="160" x2="210" y2="180" />
                    <line x1="230" y1="163" x2="230" y2="177" />
                    <line x1="250" y1="170" x2="250" y2="170" />
                    <line x1="270" y1="177" x2="270" y2="163" />
                    <line x1="290" y1="180" x2="290" y2="160" />
                    <line x1="310" y1="175" x2="310" y2="165" />
                  </g>
                </g>

                <!-- Floating Ribosomes / Nutrients (Many tiny pulsing particles) -->
                <g class="ribosomes-group">
                  <!-- Group 1 -->
                  <circle cx="160" cy="210" r="2" fill="#c9a96e" opacity="0.8">
                    <animate attributeName="opacity" values="0.3;0.9;0.3" dur="2s" repeatCount="indefinite" />
                  </circle>
                  <circle cx="340" cy="230" r="1.5" fill="#f5e6c8" opacity="0.7">
                    <animate attributeName="opacity" values="0.8;0.2;0.8" dur="3s" repeatCount="indefinite" />
                  </circle>
                  <circle cx="210" cy="140" r="2.5" fill="#1d7a4e" opacity="0.6">
                    <animate attributeName="opacity" values="0.2;0.8;0.2" dur="2.5s" repeatCount="indefinite" />
                  </circle>
                  <circle cx="290" cy="360" r="2" fill="#c9a96e" opacity="0.8">
                    <animate attributeName="opacity" values="0.4;0.9;0.4" dur="2.8s" repeatCount="indefinite" />
                  </circle>
                  <circle cx="280" cy="130" r="1.5" fill="#ffffff" opacity="0.9">
                    <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.8s" repeatCount="indefinite" />
                  </circle>
                  <circle cx="140" cy="270" r="2" fill="#f5e6c8" opacity="0.5">
                    <animate attributeName="opacity" values="0.1;0.9;0.1" dur="4s" repeatCount="indefinite" />
                  </circle>
                  <circle cx="350" cy="260" r="2.5" fill="#1d7a4e" opacity="0.7">
                    <animate attributeName="opacity" values="0.7;0.1;0.7" dur="3.2s" repeatCount="indefinite" />
                  </circle>
                  <circle cx="200" cy="360" r="1.5" fill="#c9a96e" opacity="0.8">
                    <animate attributeName="opacity" values="0.3;0.9;0.3" dur="2.2s" repeatCount="indefinite" />
                  </circle>
                </g>
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       MARQUEE STRIP
       ========================================== -->
  <section class="marquee-section">
    <div class="marquee-track" id="marquee-track">
      {[...siteConfig.marqueeKeywords, ...siteConfig.marqueeKeywords].map((keyword) => (
        <div class="marquee-item">
          <span class="marquee-dot"></span>
          {keyword}
        </div>
      ))}
    </div>
  </section>

  <!-- ==========================================
       ABOUT DR. MOHAPATRA
       ========================================== -->
  <section class="about-section" id="about">
    <div class="container">
      <div class="about-grid">
        <!-- Left: Photo -->
        <div class="about-image-col reveal-left">
          <div class="about-image-frame">
            <img
              src={siteConfig.founder.photoUrl}
              alt={siteConfig.founder.photoAlt}
            />
            <div class="about-badge">
              <span class="about-badge-num">28+</span>
              <span class="about-badge-label">Years of Surgery</span>
            </div>
          </div>
        </div>

        <!-- Right: Bio & Credentials -->
        <div class="about-text-col reveal-right">
          <span class="section-tag">The Creator</span>
          <h2 class="about-name">{siteConfig.founder.name}</h2>
          <p class="about-role">{siteConfig.founder.title}</p>
          <p class="about-bio">{siteConfig.founder.shortBio}</p>

          <div class="credential-card">
            <h4>Credentials</h4>
            <ul class="credential-list">
              {siteConfig.founder.credentials.map((cred) => (
                <li>{cred}</li>
              ))}
            </ul>
          </div>

          <div style="margin-top: 20px;">
            <a href={`${base}/about`} class="btn-outline">
              Know More <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       SIX PILLARS OF THE PROTOCOL
       ========================================== -->
  <section class="pillars-section" id="protocol">
    <div class="container">
      <div class="pillars-header reveal">
        <span class="section-tag">The {siteConfig.siteName} Protocol</span>
        <h2 class="section-title">Six Pillars of Cellular Revival</h2>
        <p class="section-subtitle">
          A holistic, science-backed framework designed to heal, protect, and revive your health at the deepest biological level.
        </p>
      </div>

      <div class="pillars-grid">
        {siteConfig.pillars.map((pillar, index) => (
          <div class="pillar-card reveal" style={`transition-delay: ${index * 0.1}s`}>
            <div class="pillar-icon">
              <i class={`fa-solid ${pillar.icon}`}></i>
            </div>
            <h3 class="pillar-name">{pillar.name}</h3>
            <p class="pillar-desc">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================
       CELLUREVA PROTOCOLS
       ========================================== -->
  <section class="protocols-section" id="protocols">
    <div class="container">
      <div class="protocols-header reveal">
        <span class="section-tag">Specialized Protocols</span>
        <h2 class="section-title">CelluReva™ Protocols</h2>
        <p class="section-subtitle">
          Tailored cellular health programs for every dimension of life — from leadership and parenting to chronic disease reversal.
        </p>
      </div>

      <!-- Filter Tabs -->
      <div class="protocols-tabs reveal" id="protocol-tabs">
        {siteConfig.protocolCategories.map((cat, i) => (
          <button
            class={`protocol-tab ${i === 0 ? 'active' : ''}`}
            data-filter={cat.key}
            type="button"
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Protocol Cards Grid -->
      <div class="protocols-grid" id="protocols-grid">
        {siteConfig.protocols.map((protocol, index) => (
          <a
            href={protocol.link}
            class="protocol-card reveal"
            data-category={protocol.category}
            style={`transition-delay: ${index * 0.08}s`}
          >
            <div class="protocol-icon-wrap">
              <i class={`fa-solid ${protocol.icon}`}></i>
            </div>
            <span class="protocol-category-tag">{protocol.category}</span>
            <h3 class="protocol-name">{protocol.name}</h3>
            <p class="protocol-desc">{protocol.description}</p>
            <span class="protocol-cta">
              Learn More <i class="fa-solid fa-arrow-right"></i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================
       HOW IT WORKS — 5-STEP JOURNEY
       ========================================== -->
  <section class="steps-section" id="how-it-works">
    <div class="container">
      <div class="steps-header reveal">
        <span class="section-tag">Your Healing Journey</span>
        <h2 class="section-title">How {siteConfig.siteName} Works</h2>
        <p class="section-subtitle">
          A transformative 5-step journey from biological breakdown to lasting cellular vitality.
        </p>
      </div>

      <div class="steps-track">
        {siteConfig.steps.map((step, index) => (
          <a href={step.link} class="step-card reveal" style={`transition-delay: ${index * 0.12}s`}>
            <div class="step-number">{index + 1}</div>
            <div class="step-content">
              <h3 class="step-name">{step.name}</h3>
              <p class="step-desc">{step.description}</p>
              <span class="step-link">
                Explore <i class="fa-solid fa-arrow-right"></i>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==========================================
       BOOKS SECTION
       ========================================== -->
  <section class="books-section" id="books">
    <div class="container">
      <div class="books-header reveal">
        <span class="section-tag">Publications</span>
        <h2 class="section-title">Books by {siteConfig.founder.name}</h2>
        <p class="section-subtitle">
          Deeply human, science-rooted guides that explore healing at the cellular level.
        </p>
      </div>

      <div class="books-grid">
        {siteConfig.books.map((book) => (
          <div class="book-card reveal">
            <div class="book-cover-wrap">
              <img src={book.imageUrl} alt={book.imageAlt} />
            </div>
            <div class="book-info">
              <span class="book-label">Featured Publication</span>
              <h3>{book.title}</h3>
              <p class="book-subtitle">{book.subtitle}</p>
              <p>{book.description}</p>
              <ul class="book-features">
                {book.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <div style="margin-top: 12px;">
                {book.isInternal ? (
                  <a href={`${base}${book.buyLink}`} class="btn-primary">
                    {book.buyText} <i class="fa-solid fa-arrow-right"></i>
                  </a>
                ) : (
                  <a href={book.buyLink} target="_blank" rel="noopener noreferrer" class="btn-primary">
                    <i class="fa-brands fa-amazon"></i> {book.buyText}
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
