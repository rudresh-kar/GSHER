---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About Us | Global Self-Healthcare Education and Research (GSHER)"
  description="Join our mission to shift from doctor-dependent disease treatment to proactive, daily self-care. Learn about our founder Dr. Biswajit Mohapatra, our advisory board, and student testimonials."
  keywords="Global Self-Healthcare, Self Healthcare Education, Dr Biswajit Mohapatra, Cellular Health, CelluReva, Health Protection, No Prescription Point, GSHER India"
>
  <!-- SEO Open Graph and Twitter Card tags in body (fully parsed by modern crawlers) -->
  <meta property="og:title" content="About Us | Global Self-Healthcare Education and Research (GSHER)" />
  <meta property="og:description" content="Discover our mission to transition from reactive treatment to proactive self-care. Read the inspiring journey of our founder Dr. Biswajit Mohapatra and see how we are building healthier humans." />
  <meta property="og:image" content="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1440,h=756,fit=crop,f=jpeg/dWxnO74qGGcN789B/img_20240815_104501049-dWxb2xjlRMUgnMWZ.jpg" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.globalselfhealthcare.org/about" />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- JSON-LD Structured Data Schema for SEO -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "About Us | Global Self-Healthcare Education and Research",
      "description": "Learn about our mission to change the concept of healthcare to self-healthcare through cellular revival and proactive wellness education.",
      "url": "https://www.globalselfhealthcare.org/about",
      "publisher": {
        "@type": "Organization",
        "name": "Global Self-Healthcare Education and Research (GSHER)",
        "logo": {
          "@type": "ImageObject",
          "url": "https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=90,fit=crop/dWxnO74qGGcN789B/queen-logo-design-1-YD0ro0oK5jUnP1oQ.png"
        }
      },
      "mainEntity": {
        "@type": "Person",
        "name": "Dr. Biswajit Mohapatra",
        "jobTitle": "Founder & Chairman",
        "description": "Consultant Laparoscopic Surgeon and NLP Health Motivator leading the Global Self-Healthcare movement."
      }
    }
  </script>

  <main class="about-page">
    <!-- ==========================================
         Section 1: Hero Banner
         ========================================== -->
    <section class="about-hero">
      <div class="hero-overlay"></div>
      <div class="container hero-content">
        <span class="hero-subtitle-tag">Our Vision & Origin</span>
        <h1 class="hero-title">Reduce Your Hospital Visits with <span class="accent-text">Self-Healthcare</span></h1>
        <p class="hero-subtitle">It’s not something that we just strive for – we live by this principle every day.</p>
        <div class="hero-chevron">
          <a href="#mission" class="scroll-down-btn" aria-label="Scroll to Mission"><i class="fa-solid fa-chevron-down"></i></a>
        </div>
      </div>
    </section>

    <!-- ==========================================
         Section 2: Mission Statement
         ========================================== -->
    <section class="mission-section" id="mission">
      <div class="container">
        <div class="mission-card">
          <div class="mission-icon-wrap">
            <i class="fa-solid fa-hands-holding-child"></i>
          </div>
          <p class="mission-text">
            "We are on a mission to change the concept of healthcare to <span class="highlight-green">self-healthcare</span>."
          </p>
          <div class="decor-bar"></div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         Section 3: Founder & Personal Story
         ========================================== -->
    <section class="founder-section" id="founder">
      <div class="container">
        <!-- Main Founder Profile Grid -->
        <div class="founder-grid">
          <div class="founder-image-col">
            <div class="image-frame">
              <img
                src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=600,h=800,fit=crop/dWxnO74qGGcN789B/img_1063-AzGOPqQz18fqkDNL.JPG"
                alt="Dr. Biswajit Mohapatra, Chairman of GSHER"
                class="founder-portrait"
              />
              <div class="image-badge">
                <span class="badge-num">28+</span>
                <span class="badge-lbl">Years of Surgery</span>
              </div>
            </div>

            <!-- Compact book recommendation card below the portrait (Desktop Only) -->
            <div class="book-story-footer desktop-only">
              <img
                src="https://assets.zyrosite.com/dWxnO74qGGcN789B/care-for-your-health_ebook-cover-YyvygBN99jFz2egO.jpg"
                alt="Care for Your Health Book Cover"
                class="book-mini-cover"
              />
              <div class="book-mini-details">
                <span class="book-mini-label">Founder's Health Manual</span>
                <h4 class="book-mini-title">Care for Your Health</h4>
                <a href="https://www.amazon.in/Care-Your-Health-Manual-Healthy/dp/1645465039/" target="_blank" rel="noopener noreferrer" class="btn-amazon-sm">
                  <i class="fa-brands fa-amazon"></i> Buy the Book on Amazon
                </a>
              </div>
            </div>
          </div>

          <div class="founder-info-col">
            <span class="section-tag">GSHER FOUNDER & CHAIRMAN</span>
            <h2 class="founder-name">Dr. Biswajit Mohapatra</h2>
            <h3 class="founder-role">Consultant Laparoscopic Surgeon & NLP Health Motivator</h3>
            <p class="founder-bio-text">
              Dr. Biswajit Mohapatra is a distinguished consultant laparoscopic surgeon practicing in Rourkela, India. After successfully practicing conventional surgery for over 28 years and qualifying as a certified Neuro-Linguistic Programming (NLP) Health Motivator, he embarked on a dedicated journey to transition from reactive treatment protocols to proactive lifestyle disciplines.
            </p>
            <p class="founder-bio-text">
              His mission centers on the <strong>Promotion, Protection, and Preservation of health</strong>, empowering individuals with direct biological self-care guidelines to maintain vibrant well-being throughout their entire lives.
            </p>

            <!-- Personal Story Card -->
            <div class="story-card">
              <div class="story-header">
                <i class="fa-solid fa-compass-drafting story-icon"></i>
                <h4>The Story of Personal Awakening</h4>
              </div>
              <div class="story-body">
                <p>
                  <strong>2010 was a year of awakening</strong> from the trance created by my conventional medical education and surgical profession. I was a complete workaholic, dedicating my life 24/7/365 to patients and hospital rounds, pursuing professional acclaim while neglecting my own body.
                </p>
                <p>
                  On January 10, 2010, I experienced a strange chest sensation and ran an ECG. My physician friend looked at the results in shock, asking, <em>"Is this your ECG?"</em> It showed severe irregular heart rhythm. He immediately prescribed emergency antiarrhythmic medicine and ordered a cardiology workup.
                </p>
                <p>
                  Those next 16 days of cardiac evaluation were the most challenging, introspective days of my life. Shattered, I realized: <strong>I was a highly skilled disease-care professional, but I knew almost nothing about preserving actual health.</strong>
                </p>
                <p>
                  I decided to rebuild my body. Re-studying physiology, biochemistry, and cell biology, I applied core health principles to myself. By January 10, 2013, when I took stock of my health gains and losses, my gains page was overflowing with energy, time, family connection, and zero stress, while my losses page was completely empty.
                </p>
                <p>
                  This eureka moment sparked my entry into health education: what saved my life can save the lives of millions.
                </p>
              </div>
            </div>

            <!-- Compact book recommendation card right below the story (Mobile Only) -->
            <div class="book-story-footer mobile-only">
              <img
                src="https://assets.zyrosite.com/dWxnO74qGGcN789B/care-for-your-health_ebook-cover-YyvygBN99jFz2egO.jpg"
                alt="Care for Your Health Book Cover"
                class="book-mini-cover"
              />
              <div class="book-mini-details">
                <span class="book-mini-label">Founder's Health Manual</span>
                <h4 class="book-mini-title">Care for Your Health</h4>
                <a href="https://www.amazon.in/Care-Your-Health-Manual-Healthy/dp/1645465039/" target="_blank" rel="noopener noreferrer" class="btn-amazon-sm">
                  <i class="fa-brands fa-amazon"></i> Buy the Book on Amazon
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         Section 4: Advisory Board
         ========================================== -->
    <section class="advisors-section" id="advisors">
      <div class="container">
        <div class="section-header-centered">
          <span class="section-tag">GOVERNING BOARD</span>
          <h2 class="section-title">Our Advisory Board</h2>
          <p class="section-subtitle">A team of visionaries, academicians, and clinicians guiding our research and education.</p>
        </div>

        <div class="advisors-grid">
          <!-- Advisor 1: Dr. Subhasis Das -->
          <div class="advisor-card">
            <div class="advisor-photo-wrapper">
              <img
                src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=300,h=350,fit=crop/dWxnO74qGGcN789B/s-das-2023-06-03-at-05.52.40-mjELQOPz5zIZgp2E.jpeg"
                alt="Dr. Subhasis Das"
                class="advisor-photo"
              />
            </div>
            <div class="advisor-details">
              <h3 class="advisor-name">Dr. Subhasis Das</h3>
              <p class="advisor-role">President, Ardent Steel & Advisor, GSHER</p>
              <p class="advisor-bio">
                Dr. Subhasish Das is a visionary entrepreneur and leader in sustainability, circular economy, and waste-to-energy. Utilizing torrefaction technology, he pioneered biomass pellet production, replacing coal and reducing carbon footprints. He also serves as the founder of Housify, focusing on sustainable and affordable housing projects.
              </p>
            </div>
          </div>

          <!-- Advisor 2: Dr. Kalyani Mishra -->
          <div class="advisor-card">
            <div class="advisor-photo-wrapper">
              <img
                src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=300,h=350,fit=crop/dWxnO74qGGcN789B/kmimage-2023-06-03-at-07.22.13-AMqXx5P56ytoLWR7.jpeg"
                alt="Dr. Kalyani Mishra"
                class="advisor-photo"
              />
            </div>
            <div class="advisor-details">
              <h3 class="advisor-name">Dr. Kalyani Mishra</h3>
              <p class="advisor-role">Professor of Psychology & Mental Wellness Advisor</p>
              <p class="advisor-bio">
                Dr. Kalyani Mishra (OES-1) is a retired professor with 40 years of academic expertise in psychology. She has guided 14 PhD scholars, presented papers at 450+ global conferences, and authored numerous textbooks. Currently, she serves as an Independent Director of Rourkela Smart City Limited, specializing in community counseling.
              </p>
            </div>
          </div>

          <!-- Advisor 3: Dr. S.K. Mahapatra -->
          <div class="advisor-card">
            <div class="advisor-photo-wrapper">
              <img
                src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=300,h=350,fit=crop/dWxnO74qGGcN789B/photo-from-dr-biswajit-mohapatra-YrDL6kEV5lHEvZLB.png"
                alt="Dr. S.K. Mahapatra"
                class="advisor-photo"
              />
            </div>
            <div class="advisor-details">
              <h3 class="advisor-name">Dr. S.K. Mahapatra, DNB</h3>
              <p class="advisor-role">Senior Orthopedic Surgeon & Health Educator</p>
              <p class="advisor-bio">
                A distinguished orthopedic surgeon with 12+ years of surgical experience in complex trauma and arthroplasty (Fellowship under Dr. Vikram Shah). Beyond his surgical practice, Dr. Mahapatra is deeply passionate about wellness coaching, lecturing on preventive measures, orthopedic health, and lifestyle changes.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         Section 5: Testimonials
         ========================================== -->
    <section class="testimonials-section" id="testimonials">
      <div class="container">
        <div class="section-header-centered">
          <span class="section-tag font-white">IMPACT STORY</span>
          <h2 class="section-title font-white">Student Testimonials</h2>
          <p class="section-subtitle font-white">Read how our self-healthcare elective courses at NIT Rourkela have changed students' health perspectives.</p>
        </div>

        <div class="testimonials-grid">
          <!-- Testimonial 1: Sneha Swain -->
          <div class="testimonial-card">
            <div class="quote-icon"><i class="fa-solid fa-quote-left"></i></div>
            <p class="testimonial-quote">
              We are in an era of healthcare and self-care; the two essentials for a great life! It is 2023, and people are prioritizing themselves now, but often it is a failed attempt due to incorrect approaches. This course gave me the 'study and cognize' time to notice tiny issues that usually go unnoticed. I am glad I listened to my heart.
            </p>
            <div class="testimonial-user">
              <img
                src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=90,fit=crop/dWxnO74qGGcN789B/sneha-swain-AzGOVEgM7li15DL1.jpg"
                alt="Sneha Swain"
                class="user-avatar"
              />
              <div class="user-info">
                <h4 class="user-name">Sneha Swain</h4>
                <p class="user-title">Student, NIT Rourkela</p>
              </div>
            </div>
          </div>

          <!-- Testimonial 2: Pius Ojara -->
          <div class="testimonial-card">
            <div class="quote-icon"><i class="fa-solid fa-quote-left"></i></div>
            <p class="testimonial-quote">
              I have learned to be more self-aware, and that every person and thing we face contributes to our happiness or dissatisfaction. This course helped me understand that we shape our biology and overall wellbeing through daily actions.
            </p>
            <div class="testimonial-user">
              <img
                src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=90,fit=crop/dWxnO74qGGcN789B/whatsapp-image-2023-04-16-at-16.59.41-Y4Ll07KpK6UnrkBa.jpeg"
                alt="Pius Ojara"
                class="user-avatar"
              />
              <div class="user-info">
                <h4 class="user-name">Pius Ojara</h4>
                <p class="user-title">Ugandan Student, NIT Rourkela</p>
              </div>
            </div>
          </div>

          <!-- Testimonial 3: Olivia Newton -->
          <div class="testimonial-card">
            <div class="quote-icon"><i class="fa-solid fa-quote-left"></i></div>
            <p class="testimonial-quote">
              Thank you so much for taking the time to take a course for us. It was one of the most refreshing classes I've had, and I always got to learn something new. It was very interesting to learn the science behind how we can take care of ourselves. The course brought new meaning to 'Prevention is better than a cure'.
            </p>
            <div class="testimonial-user">
              <img
                src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=90,fit=crop/dWxnO74qGGcN789B/whatsapp-image-2023-04-15-at-22.31.13-mv0LVq0358uzbG89.jpeg"
                alt="Olivia Newton"
                class="user-avatar"
              />
              <div class="user-info">
                <h4 class="user-name">Olivia Newton</h4>
                <p class="user-title">Student, NIT Rourkela</p>
              </div>
            </div>
          </div>

          <!-- Testimonial 4: Shubham Sahoo -->
          <div class="testimonial-card">
            <div class="quote-icon"><i class="fa-solid fa-quote-left"></i></div>
            <p class="testimonial-quote">
              My final semester subject was a good choice. This topic has cleared up many of my questions. Dr. Biswajit Mohapatra's unique teaching style and experience are great! This subject includes lifestyle, diet, psychology, and self-healing, which can totally dispel common misconceptions. I thank myself for choosing this topic.
            </p>
            <div class="testimonial-user">
              <img
                src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=90,fit=crop/dWxnO74qGGcN789B/img_20230415_230606-A3QBk5Ze06iDE1j7.jpg"
                alt="Shubham Sahoo"
                class="user-avatar"
              />
              <div class="user-info">
                <h4 class="user-name">Shubham Sahoo</h4>
                <p class="user-title">B.Tech Student, NIT Rourkela</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<!-- ==========================================
     Astro Scoped Styling
     ========================================== -->
<style>
  /* Base variables and reset helpers matching global system */
  :root {
    --color-primary-teal: var(--color-primary);
    --color-teal-hover: var(--color-primary-dark);
    --color-mint-light: var(--color-primary-light);
    --color-accent-gold: var(--color-accent);
    --color-dark-grey: var(--color-text-dark);
    --color-light-grey: var(--color-bg-alt);
    --color-border-grey: rgba(32, 107, 62, 0.12);
  }

  .font-white {
    color: #ffffff !important;
  }

  .about-page {
    font-family: var(--font-body);
    color: var(--color-dark-grey);
    background-color: var(--cr-cream);
    overflow-x: hidden;
  }

  /* ==========================================
     Section 1: Hero styling
     ========================================== */
  .about-hero {
    position: relative;
    background-image: url('https://assets.zyrosite.com/dWxnO74qGGcN789B/20240119_090236-AR0V913Kx2Ck86ql.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    height: 75vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 24px;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(rgba(12, 90, 52, 0.75), rgba(10, 40, 25, 0.85));
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    width: 100%;
    color: #ffffff;
    animation: fadeIn 1.2s ease-out;
    /* Reset values inherited from global index.css to restore proper flexbox centering */
    top: auto;
    left: auto;
    transform: none;
    pointer-events: auto;
    margin: 0 auto;
  }

  .hero-subtitle-tag {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent-gold);
    display: block;
    margin-bottom: 16px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    line-height: 1.2;
    margin-bottom: 24px;
    font-weight: 800;
    color: #ffffff !important; /* Explicit override of global h1 color */
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.45);
  }

  .hero-title .accent-text {
    color: var(--color-accent-gold);
    border-bottom: 3px solid var(--color-accent-gold);
    display: inline-block;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    opacity: 0.95;
    font-weight: 400;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
    color: #e5e7eb; /* High-contrast light gray */
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
  }

  .hero-chevron {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    animation: bounce 2s infinite;
  }

  @media (max-width: 768px) {
    .about-hero {
      background-attachment: scroll; /* Bypasses mobile browser fixed background rendering bugs */
      height: auto !important;
      min-height: 0 !important; /* Forces override of desktop min-height */
      padding: 170px 45px 16px !important; /* Clears fixed header with safety margin */
    }

    .hero-title {
      font-size: 1.75rem;
      line-height: 1.3;
      margin-bottom: 16px;
      letter-spacing: -0.5px;
    }

    .hero-subtitle {
      font-size: 1rem;
      line-height: 1.5;
    }

    .hero-chevron {
      display: none; /* Hide chevron on mobile to preserve vertical space */
    }

    .mission-section {
      padding: 24px 16px !important; /* Compact section padding */
    }

    .mission-card {
      padding: 24px 16px !important;
    }

    .founder-section {
      padding: 45px 0 !important;
    }

    .founder-grid {
      gap: 32px !important;
    }

    .story-card {
      padding: 20px !important;
      margin-top: 24px !important;
    }

    .book-highlight-row {
      margin-top: 40px !important;
      padding-top: 40px !important;
    }

    .advisors-section {
      padding: 45px 0 !important;
    }

    .testimonials-section {
      padding: 45px 0 !important;
    }
  }

  .scroll-down-btn {
    color: #ffffff;
    font-size: 24px;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.3s;
  }

  .scroll-down-btn:hover {
    opacity: 1;
  }

  /* ==========================================
     Section 2: Mission Section
     ========================================== */
  .mission-section {
    padding: 50px 0;
    background-color: var(--color-light-grey);
    text-align: center;
  }

  .mission-card {
    max-width: 900px;
    margin: 0 auto;
    background: #ffffff;
    padding: 50px 40px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    border-left: 5px solid var(--color-primary-teal);
    position: relative;
  }

  .mission-icon-wrap {
    font-size: 36px;
    color: var(--color-primary-teal);
    margin-bottom: 20px;
  }

  .mission-text {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    color: var(--color-dark-grey);
    line-height: 1.4;
    font-weight: 500;
  }

  .highlight-green {
    color: var(--color-primary-teal);
    font-weight: 700;
  }

  .decor-bar {
    width: 60px;
    height: 3px;
    background: var(--color-accent-gold);
    margin: 25px auto 0 auto;
    border-radius: 2px;
  }

  /* ==========================================
     Section 3: Founder Section
     ========================================== --> */
  .founder-section {
    padding: 65px 0;
    background-color: #ffffff;
  }

  .founder-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: flex-start;
  }

  @media (min-width: 992px) {
    .founder-grid {
      grid-template-columns: 5fr 7fr;
      gap: 60px;
    }
  }

  .founder-image-col {
    position: sticky;
    top: 100px;
  }

  .image-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
  }

  .founder-portrait {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .image-frame:hover .founder-portrait {
    transform: scale(1.03);
  }

  .image-badge {
    position: absolute;
    bottom: 25px;
    left: 25px;
    background: var(--color-primary-teal);
    color: #ffffff;
    padding: 15px 25px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
  }

  .badge-num {
    font-size: 28px;
    font-weight: 700;
    font-family: var(--font-heading);
    color: var(--color-accent-gold);
    line-height: 1;
  }

  .badge-lbl {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    margin-top: 4px;
  }

  .section-tag {
    font-size: 13px;
    font-weight: 800;
    color: var(--color-primary-teal);
    letter-spacing: 2px;
    display: block;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .founder-name {
    font-family: var(--font-heading);
